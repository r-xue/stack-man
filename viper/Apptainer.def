Bootstrap: docker
From: ubuntu:24.04
Stage: build

%arguments
    PIXI_ENV=default

%files
    # Copy your local Pixi files into the container build context
    pixi.toml /opt/viper/pixi.toml
    pixi.lock /opt/viper/pixi.lock

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y curl ca-certificates git
    
    # Install Pixi globally inside the build container
    curl -fsSL https://pixi.sh/install.sh | bash
    export PATH="/root/.pixi/bin:$PATH"

    # Install the requested environment
    cd /opt/viper
    pixi install --locked --environment {{ PIXI_ENV }}


# ==============================================================================
# FINAL STAGE
# ==============================================================================
Bootstrap: docker
From: ubuntu:24.04
Stage: final

%arguments
    PIXI_ENV=default

%files from build
    # Only copy the strictly necessary built files! This drops all cache bloat automatically.
    /opt/viper/.pixi/envs/{{ PIXI_ENV }} /opt/viper/.pixi/envs/{{ PIXI_ENV }}
    /opt/viper/pixi.toml /opt/viper/pixi.toml
    /root/.pixi/bin/pixi /usr/local/bin/pixi

%environment
    # Ensure the container knows where Pixi and the specified environment are
    export PATH="/opt/viper/.pixi/envs/{{ PIXI_ENV }}/bin:/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin"
    export HOME="/root"
    export PIXI_PROJECT_DIR="/opt/viper"
    
    # Redirect all package caches to /tmp since the container image is read-only
    export PIXI_CACHE_DIR="/tmp/.pixi_cache"
    export RATTLER_CACHE_DIR="/tmp/.rattler_cache"
    export UV_CACHE_DIR="/tmp/.uv_cache"
    
    # Redirect standard Linux app caches to /tmp
    export XDG_CACHE_HOME="/tmp/.cache"
    export XDG_CONFIG_HOME="/tmp/.config"
    export XDG_DATA_HOME="/tmp/.local/share"
    export XDG_STATE_HOME="/tmp/.local/state"
    
%post
    export DEBIAN_FRONTEND=noninteractive
    
    # 1. Install bare minimum runtime dependencies
    apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates && \
    apt-get autoremove -y && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

%runscript
    # Keep `pixi run` so custom tasks still work correctly!
    # --as-is ensures Pixi uses the environment as it exists and doesn't try to resolve or install anything.
    cd /opt/viper
    exec pixi run --as-is -e {{ PIXI_ENV }} "$@"
